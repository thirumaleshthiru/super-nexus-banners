generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model Product {
  id                      String                        @id @default(cuid())
  shopifyId               String                        @unique
  title                   String
  handle                  String                        @unique
  description             String?
  featuredImage           String?
  optimizedImage          String?
  imageAltTag             String?
  originalImageSize       Int?
  optimizedImageSize      Int?
  price                   String
  currencyCode            String                        @default("USD")
  status                  String                        @default("active")
  vendor                  String?
  productType             String?
  tags                    String?
  variantId               String?
  variants                String?
  inventoryQuantity       Int?
  inventoryTracked        Boolean                       @default(true)
  lowStockThreshold       Int                           @default(5)
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  banners                 Banner[]
  bannerSlides            BannerSlide[]
  bottomBanners           BottomBanner[]
  bottomBannerSlides      BottomBannerSlide[]
  productBannerCustomization ProductBannerCustomization?
}

model Banner {
  id                          String            @id @default(cuid())
  isActive                    Boolean           @default(false)
  bannerWidth                 String            @default("full")
  customWidth                 String?
  bannerHeight                String            @default("auto")
  customHeight                String?
  bannerPadding               String            @default("12")
  bannerLeftMargin            String            @default("0")
  bannerRightMargin           String            @default("0")
  bannerTopMargin             String            @default("0")
  bannerBottomMargin          String            @default("0")
  bannerBorderRadius          String            @default("8")
  priority                    Int               @default(0)
  areMessagesCarousel         Boolean           @default(false)
  messages                    String
  messageFontSize             String            @default("16")
  messagePosition             String            @default("left")
  messageColor                String            @default("#1a1a1a")
  messagePadding              String            @default("8")
  isTimer                     Boolean           @default(false)
  startTime                   DateTime?
  endTime                     DateTime?
  timerBackgroundColor        String            @default("rgba(0,0,0,0.1)")
  timerBorderColor            String            @default("rgba(0,0,0,0.15)")
  timerPadding                String            @default("6")
  timerTextColor              String            @default("#1a1a1a")
  timerFontSize               String            @default("14")
  hasProduct                  Boolean           @default(false)
  productId                   String?
  productTitle                String?
  productImage                String?
  productFontSize             String            @default("14")
  actionType                  String            @default("view_product")
  actionButtonText            String?
  actionButtonTextColor       String            @default("#ffffff")
  actionButtonBackgroundColor String            @default("#1a1a1a")
  actionButtonBorderRadius    String            @default("6")
  actionButtonPadding         String            @default("8")
  bgColor                     String            @default("#f7f7f7")
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt
  product                     Product?          @relation(fields: [productId], references: [id])
  analytics                   BannerAnalytics[]
  slides                      BannerSlide[]
}

model BannerSlide {
  id               String    @id @default(cuid())
  bannerId         String
  order            Int       @default(0)
  message          String
  isTimer          Boolean   @default(false)
  startTime        DateTime?
  endTime          DateTime?
  hasProduct       Boolean   @default(false)
  productId        String?
  productTitle     String?
  productImage     String?
  actionType       String    @default("view_product")
  actionButtonText String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  productVariantId String?
  banner           Banner    @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  product          Product?  @relation(fields: [productId], references: [id])

  @@index([bannerId, order])
}

model BannerAnalytics {
  id           String   @id @default(cuid())
  bannerId     String
  eventType    String
  timestamp    DateTime @default(now())
  sessionId    String?
  shopDomain   String
  productId    String?
  messageIndex Int?
  banner       Banner   @relation(fields: [bannerId], references: [id], onDelete: Cascade)

  @@index([bannerId, eventType])
  @@index([timestamp])
  @@index([shopDomain])
}

model BottomBanner {
  id                               String                  @id @default(cuid())
  isActive                         Boolean                 @default(false)
  bannerWidth                      String                  @default("full")
  customWidth                      String?
  bannerHeight                     String                  @default("auto")
  customHeight                     String?
  bannerPadding                    String                  @default("12")
  bannerLeftMargin                 String                  @default("0")
  bannerRightMargin                String                  @default("0")
  bannerTopMargin                  String                  @default("0")
  bannerBottomMargin               String                  @default("0")
  bannerBorderRadius               String                  @default("8")
  priority                         Int                     @default(0)
  areMessagesCarousel              Boolean                 @default(false)
  messages                         String
  messageFontSize                  String                  @default("16")
  messagePosition                  String                  @default("left")
  messageColor                     String                  @default("#1a1a1a")
  messagePadding                   String                  @default("8")
  isTimer                          Boolean                 @default(false)
  startTime                        DateTime?
  endTime                          DateTime?
  timerBackgroundColor             String                  @default("rgba(0,0,0,0.1)")
  timerBorderColor                 String                  @default("rgba(0,0,0,0.15)")
  timerPadding                     String                  @default("6")
  timerTextColor                   String                  @default("#1a1a1a")
  timerFontSize                    String                  @default("14")
  hasProduct                       Boolean                 @default(false)
  productId                        String?
  productTitle                     String?
  productImage                     String?
  showImage                        Boolean                 @default(false)
  priceOverride                    String?
  couponCode                       String?
  productFontSize                  String                  @default("14")
  actionType                       String                  @default("view_product")
  actionButtonText                 String?
  actionButtonTextColor            String                  @default("#ffffff")
  actionButtonBackgroundColor      String                  @default("#1a1a1a")
  actionButtonBorderRadius         String                  @default("6")
  actionButtonPadding              String                  @default("8")
  showAddToCartButton              Boolean                 @default(false)
  showViewProductButton            Boolean                 @default(false)
  addToCartButtonText              String                  @default("Add to Cart")
  viewProductButtonText            String                  @default("View Product")
  addToCartButtonTextColor         String                  @default("#ffffff")
  addToCartButtonBackgroundColor   String                  @default("#007cba")
  viewProductButtonTextColor       String                  @default("#ffffff")
  viewProductButtonBackgroundColor String                  @default("#1a1a1a")
  bgColor                          String                  @default("#f7f7f7")
  createdAt                        DateTime                @default(now())
  updatedAt                        DateTime                @updatedAt
  product                          Product?                @relation(fields: [productId], references: [id])
  analytics                        BottomBannerAnalytics[]
  slides                           BottomBannerSlide[]
}

model BottomBannerSlide {
  id                    String       @id @default(cuid())
  bottomBannerId        String
  order                 Int          @default(0)
  message               String
  isTimer               Boolean      @default(false)
  startTime             DateTime?
  endTime               DateTime?
  hasProduct            Boolean      @default(false)
  productId             String?
  productTitle          String?
  productImage          String?
  showImage             Boolean      @default(false)
  priceOverride         String?
  couponCode            String?
  productVariantId      String?
  actionType            String       @default("view_product")
  actionButtonText      String?
  showAddToCartButton   Boolean      @default(false)
  showViewProductButton Boolean      @default(false)
  addToCartButtonText   String       @default("Add to Cart")
  viewProductButtonText String       @default("View Product")
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  bottomBanner          BottomBanner @relation(fields: [bottomBannerId], references: [id], onDelete: Cascade)
  product               Product?     @relation(fields: [productId], references: [id])

  @@index([bottomBannerId, order])
}

model BottomBannerAnalytics {
  id             String       @id @default(cuid())
  bottomBannerId String
  eventType      String
  timestamp      DateTime     @default(now())
  sessionId      String?
  shopDomain     String
  productId      String?
  messageIndex   Int?
  bottomBanner   BottomBanner @relation(fields: [bottomBannerId], references: [id], onDelete: Cascade)

  @@index([bottomBannerId, eventType])
  @@index([timestamp])
  @@index([shopDomain])
}

model StaticBanner {
  id                    String                  @id @default(cuid())
  isActive              Boolean                 @default(false)
  bannerWidth           String                  @default("full")
  customWidth           String?
  bannerHeight          String                  @default("auto")
  customHeight          String?
  bannerPadding         String                  @default("12")
  bannerLeftMargin      String                  @default("0")
  bannerRightMargin     String                  @default("0")
  bannerTopMargin       String                  @default("0")
  bannerBottomMargin    String                  @default("0")
  bannerBorderRadius    String                  @default("8")
  priority              Int                     @default(0)
  areMessagesCarousel   Boolean                 @default(false)
  messages              String
  messageFontSize       String                  @default("16")
  messagePosition       String                  @default("left")
  messageColor          String                  @default("#1a1a1a")
  messagePadding        String                  @default("8")
  isTimer               Boolean                 @default(false)
  startTime             DateTime?
  endTime               DateTime?
  timerBackgroundColor  String                  @default("rgba(0,0,0,0.1)")
  timerBorderColor      String                  @default("rgba(0,0,0,0.15)")
  timerPadding          String                  @default("6")
  timerTextColor        String                  @default("#1a1a1a")
  timerFontSize         String                  @default("14")
  hasCoupon             Boolean                 @default(false)
  couponCode            String?
  couponBackgroundColor String                  @default("#fef3c7")
  couponBorderColor     String                  @default("#f59e0b")
  couponTextColor       String                  @default("#92400e")
  couponFontSize        String                  @default("14")
  couponPadding         String                  @default("8")
  bgColor               String                  @default("#f7f7f7")
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  analytics             StaticBannerAnalytics[]
  slides                StaticBannerSlide[]
}

model StaticBannerSlide {
  id             String       @id @default(cuid())
  staticBannerId String
  order          Int          @default(0)
  message        String
  isTimer        Boolean      @default(false)
  startTime      DateTime?
  endTime        DateTime?
  hasCoupon      Boolean      @default(false)
  couponCode     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  staticBanner   StaticBanner @relation(fields: [staticBannerId], references: [id], onDelete: Cascade)

  @@index([staticBannerId, order])
}

model StaticBannerAnalytics {
  id             String       @id @default(cuid())
  staticBannerId String
  eventType      String
  timestamp      DateTime     @default(now())
  sessionId      String?
  shopDomain     String
  messageIndex   Int?
  staticBanner   StaticBanner @relation(fields: [staticBannerId], references: [id], onDelete: Cascade)

  @@index([staticBannerId, eventType])
  @@index([timestamp])
  @@index([shopDomain])
}

model ProductBannerSettings {
  id                           String   @id @default(cuid())
  bannerHeight                 String   @default("130")
  bannerImageHeight            String   @default("80")
  bannerPadding                String   @default("10")
  bannerTitleFontSize          String   @default("15")
  bannerTitleColor             String   @default("111827")
  bannerPriceFontSize          String   @default("14")
  bannerPriceColor             String   @default("6b7280")
  showPrice                    Boolean  @default(true)
  bannerBackgroundColor        String   @default("ffffff")
  bannerBorderRadius           String   @default("12")
  button1Text                  String   @default("Add to Cart")
  button1TextColor             String   @default("ffffff")
  button1BackgroundColor       String   @default("FF6B6B")
  button1BorderColor           String   @default("FF6B6B")
  button2Text                  String   @default("Buy Now")
  button2TextColor             String   @default("FF6B6B")
  button2BackgroundColor       String   @default("ffffff")
  button2BorderColor           String   @default("FF6B6B")
  hurryUpText                  String   @default("Hurry Up! Limited Stock")
  hurryUpBannerHeight          String   @default("30")
  hurryUpBannerBackgroundColor String   @default("FF6B6B")
  hurryUpTextColor             String   @default("ffffff")
  hurryUpFontSize              String   @default("14")
  mobileBannerHeight           String   @default("90")
  mobileBannerBorderRadius     String   @default("8")
  mobileBannerMargin           String   @default("10")
  mobileProductHeight          String   @default("60")
  mobileProductPadding         String   @default("12px 16px")
  mobileTitleFontSize          String   @default("16")
  mobileTitleColor             String   @default("111827")
  mobilePriceFontSize          String   @default("14")
  mobilePriceColor             String   @default("6b7280")
  mobileButtonHeight           String   @default("40")
  mobileButtonPadding          String   @default("12px 20px")
  mobileButtonFontSize         String   @default("16")
  mobileButtonBorderRadius     String   @default("6")
  mobileButtonTextColor        String   @default("ffffff")
  mobileButtonBackgroundColor  String   @default("FF6B6B")
  mobileHurryUpHeight          String   @default("30")
  mobileHurryUpFontSize        String   @default("14")
  mobileHurryUpBackgroundColor String   @default("FF6B6B")
  mobileHurryUpTextColor       String   @default("ffffff")
  appliedTemplateId            String?
  appliedTemplateName          String?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

model ProductBannerCustomization {
  id                   String   @id @default(cuid())
  productId            String   @unique
  isShowPrice          Boolean  @default(true)
  isShowAddToCartButton Boolean @default(true)
  isShowBuyNowButton   Boolean  @default(true)
  isShowHurryUpBanner  Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  product              Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductBannerAnalytics {
  id              String   @id @default(cuid())
  productId       String
  productHandle   String
  eventType       String
  timestamp       DateTime @default(now())
  sessionId       String?
  userAgent       String?
  deviceType      String?
  variantId       String?
  quantity        Int?
  metadata        String?
  testVariantId   String?
  createdAt       DateTime @default(now())

  @@index([productId])
  @@index([productHandle])
  @@index([eventType])
  @@index([timestamp])
  @@index([sessionId])
  @@index([testVariantId])
}

model ProductBannerTest {
  id                    String                   @id @default(cuid())
  name                  String
  productId             String
  productHandle         String
  status                String                   @default("draft") // draft, running, paused, completed
  startDate             DateTime?
  endDate               DateTime?
  goalMetric            String                   @default("conversion_rate") // conversion_rate, clicks, add_to_cart
  minSampleSize         Int                      @default(100)
  confidenceLevel       Float                    @default(95.0)
  trafficAllocation     Float                    @default(100.0) // percentage of traffic to include in test
  winnerVariantId       String?
  autoSelectWinner      Boolean                  @default(true)
  notes                 String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  variants              ProductBannerVariant[]

  @@index([productId])
  @@index([productHandle])
  @@index([status])
}

model ProductBannerVariant {
  id                           String              @id @default(cuid())
  testId                       String
  name                         String              // "Control (A)", "Variant B", etc.
  trafficWeight                Float               @default(50.0) // percentage split
  isControl                    Boolean             @default(false)
  
  // Banner settings for this variant
  bannerHeight                 String              @default("80")
  bannerImageHeight            String              @default("80")
  bannerBackgroundColor        String              @default("FF6B6B")
  bannerTextColor              String              @default("ffffff")
  bannerPriceColor             String              @default("ffffff")
  bannerBorderRadius           String              @default("12")
  bannerPadding                String              @default("10")
  
  // Add to Cart button
  buttonText                   String              @default("Add to Cart")
  buttonBackgroundColor        String              @default("ffffff")
  buttonTextColor              String              @default("FF6B6B")
  buttonBorderColor            String              @default("FF6B6B")
  buttonBorderRadius           String              @default("6")
  buttonFontSize               String              @default("16")
  buttonHeight                 String              @default("45")
  
  // Buy Now button
  buyNowButtonText             String              @default("Buy Now")
  buyNowButtonBackgroundColor  String              @default("ffffff")
  buyNowButtonTextColor        String              @default("FF6B6B")
  buyNowButtonBorderColor      String              @default("FF6B6B")
  buyNowButtonBorderRadius     String              @default("6")
  buyNowButtonFontSize         String              @default("16")
  buyNowButtonHeight           String              @default("45")
  
  hurryUpText                  String              @default("Hurry Up! Limited Stock")
  hurryUpBackgroundColor       String              @default("ffffff")
  hurryUpTextColor             String              @default("FF6B6B")
  hurryUpFontSize              String              @default("14")
  hurryUpHeight                String              @default("35")
  
  pricePosition                String              @default("top-right")
  priceFontSize                String              @default("18")
  
  isShowPrice                  Boolean             @default(true)
  isShowAddToCartButton        Boolean             @default(true)
  isShowBuyNowButton           Boolean             @default(true)
  isShowHurryUpBanner          Boolean             @default(true)
  
  // Performance metrics
  views                        Int                 @default(0)
  clicks                       Int                 @default(0)
  addToCarts                   Int                 @default(0)
  buyNows                      Int                 @default(0)
  conversions                  Int                 @default(0)
  conversionRate               Float               @default(0.0)
  
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt
  test                         ProductBannerTest   @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId])
  @@index([isControl])
}

model ProductBannerTemplate {
  id                           String   @id @default(cuid())
  name                         String
  description                  String?
  category                     String   @default("custom") // custom, sale, new_arrival, bestseller, limited_time, featured
  isPrebuilt                   Boolean  @default(false)
  
  // Banner settings
  bannerHeight                 String   @default("130")
  bannerImageHeight            String   @default("80")
  bannerPadding                String   @default("10")
  bannerTitleFontSize          String   @default("15")
  bannerTitleColor             String   @default("111827")
  bannerPriceFontSize          String   @default("14")
  bannerPriceColor             String   @default("6b7280")
  bannerBackgroundColor        String   @default("ffffff")
  bannerBorderRadius           String   @default("12")
  
  // Button 1 (Add to Cart) settings
  button1Text                  String   @default("Add to Cart")
  button1TextColor             String   @default("ffffff")
  button1BackgroundColor       String   @default("FF6B6B")
  button1BorderColor           String   @default("FF6B6B")
  button1BorderRadius          String   @default("6")
  button1FontSize              String   @default("16")
  button1Height                String   @default("45")
  
  // Button 2 (Buy Now) settings
  button2Text                  String   @default("Buy Now")
  button2TextColor             String   @default("FF6B6B")
  button2BackgroundColor       String   @default("ffffff")
  button2BorderColor           String   @default("FF6B6B")
  button2BorderRadius          String   @default("6")
  button2FontSize              String   @default("16")
  button2Height                String   @default("45")
  
  // Hurry up banner settings
  hurryUpText                  String   @default("Hurry Up! Limited Stock")
  hurryUpBannerHeight          String   @default("30")
  hurryUpBannerBackgroundColor String   @default("FF6B6B")
  hurryUpTextColor             String   @default("ffffff")
  hurryUpFontSize              String   @default("14")
  
  // Visibility toggles
  showPrice                    Boolean  @default(true)
  isShowAddToCartButton        Boolean  @default(true)
  isShowBuyNowButton           Boolean  @default(true)
  isShowHurryUpBanner          Boolean  @default(true)
  
  // Usage tracking
  usageCount                   Int      @default(0)
  lastUsedAt                   DateTime?
  
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  @@index([category])
  @@index([isPrebuilt])
  @@index([usageCount])
}
