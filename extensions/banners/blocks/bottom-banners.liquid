  "name": "Bottom Banner System",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "default_message",
      "label": "Default Message",
      "default": "Welcome to our store!",
      "info": "Displayed when no active bottom banners are available"
    }
  ]
}
{% endschema %}
