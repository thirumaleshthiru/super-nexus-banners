<script>
(function() {
  'use strict';
  
  const CONFIG = {
    API_ENDPOINT: '/apps/banners-1/activeproductbanners',
    TIMEOUT: 5000,
    THEME_SELECTORS: [
      '.page-width',
      '.container',
      'main > .container',
      '.main-content',
      '#MainContent',
      '.shopify-section .container',
      '.site-width',
      'main',
      '[class*="page-width"]',
      '[class*="container"]'
    ]
  };
  
  function extractThemeStyles() {
    for (const selector of CONFIG.THEME_SELECTORS) {
      const element = document.querySelector(selector);
      if (!element) continue;
      
      const styles = window.getComputedStyle(element);
      const maxWidth = styles.maxWidth;
      const paddingLeft = styles.paddingLeft;
      const paddingRight = styles.paddingRight;
      
      if (maxWidth && maxWidth !== 'none') {
        return {
          maxWidth,
          padding: paddingLeft
        };
      }
    }
    
    return { maxWidth: '1400px', padding: '20px' };
  }
  
  function applyThemeStyles(container) {
    const themeStyles = extractThemeStyles();
    document.documentElement.style.setProperty('--theme-max-width', themeStyles.maxWidth);
    document.documentElement.style.setProperty('--theme-padding', themeStyles.padding);
  }
  
  function getCurrentProductHandle() {
    const metaOgUrl = document.querySelector('meta[property="og:url"]');
    if (metaOgUrl) {
      const match = metaOgUrl.content.match(/\/products\/([^/?#]+)/);
      if (match) return match[1];
    }
    
    const pathMatch = window.location.pathname.match(/\/products\/([^/?#]+)/);
    if (pathMatch) return pathMatch[1];
    
    if (window.ShopifyAnalytics?.meta?.product?.handle) {
      return window.ShopifyAnalytics.meta.product.handle;
    }
    
    return null;
  }
  
  async function fetchProductAjax(handle) {
    try {
      const r = await fetch(`/products/${handle}.js`);
      if (!r.ok) return null;
      const p = await r.json();
      let options = (p.options || []).map((opt, i) => ({
        name: opt.name,
        position: i + 1,
        values: Array.isArray(opt.values) ? Array.from(new Set(opt.values)) : []
      }));
      // Filter out Shopify's placeholder option (Title → Default Title)
      options = options.filter(o => {
        const isPlaceholder = (o.name || '').toLowerCase() === 'title' &&
          (!o.values || o.values.length <= 1) &&
          (o.values?.[0] || '').toLowerCase() === 'default title';
        return !isPlaceholder;
      });
      const variantsWithOptions = (p.variants || []).map(v => ({
        id: v.id,
        available: v.available,
        price: v.price,
        option1: v.option1,
        option2: v.option2,
        option3: v.option3,
        inventory_quantity: v.inventory_quantity || null
      }));
      return { options, variantsWithOptions };
    } catch (_e) {
      return null;
    }
  }

  async function fetchBannerData(handle) {
    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), CONFIG.TIMEOUT);
    
    try {
      const response = await fetch(
        `${CONFIG.API_ENDPOINT}?handle=${encodeURIComponent(handle)}`,
        {
          signal: controller.signal,
          headers: { 'Accept': 'application/json' }
        }
      );
      
      clearTimeout(timeoutId);
      
      if (!response.ok) {
        throw new Error('Failed to fetch banner data');
      }
      
      return await response.json();
    } catch (error) {
      clearTimeout(timeoutId);
      throw error;
    }
  }
  
  async function addToCart(variantId, quantity = 1) {
    const formData = new FormData();
    formData.append('id', String(variantId));
    formData.append('quantity', String(quantity));
    
    const response = await fetch('/cart/add.js', {
      method: 'POST',
      body: formData
    });
    
    if (!response.ok) {
      const text = await response.text();
      if (text.includes('sold out') || text.includes('unavailable')) {
        throw new Error('Product is currently unavailable');
      }
      throw new Error('Failed to add to cart');
    }
    
    const data = await response.json();
    
    if (window.Shopify?.onCartUpdate) {
      window.Shopify.onCartUpdate(data);
    }
    
    document.dispatchEvent(new CustomEvent('cart:updated', { detail: data }));
    
    return data;
  }
  
  function createBannerComponent(product) {
    return {
      product,
      cartLoading: false,
      buyLoading: false,
      closed: false,
      showQuantitySelector: false,
      showModal: false,
      quantity: 1,
      selectedOptions: {},

      get hasOptions() {
        return Array.isArray(this.product.options) && this.product.options.some(o => Array.isArray(o.values) && o.values.length > 0);
      },

      get selectedVariant() {
        if (!this.hasOptions || !Array.isArray(this.product.variantsWithOptions)) return null;
        return this.product.variantsWithOptions.find(v => {
          const m1 = this.selectedOptions[1] ? v.option1 === this.selectedOptions[1] : true;
          const m2 = this.selectedOptions[2] ? v.option2 === this.selectedOptions[2] : true;
          const m3 = this.selectedOptions[3] ? v.option3 === this.selectedOptions[3] : true;
          return m1 && m2 && m3;
        }) || null;
      },

      get selectedVariantId() {
        const v = this.selectedVariant;
        if (!v) return this.product.variantId;
        let id = v.id;
        if (typeof id === 'string' && id.includes('/')) id = id.split('/').pop();
        return String(id);
      },

      get selectedVariantAvailable() {
        const v = this.selectedVariant;
        if (!v) return true;
        return v.available !== false;
      },
      
      get inventoryMessage() {
        if (!this.product.shouldShowLowStock) return '';
        const quantity = this.product.inventoryQuantity;
        if (quantity === 0) return 'Out Of Stock!';
        if (quantity === 1) return 'Only <span class="stock-number">1</span> left in stock!';
        return `Only <span class="stock-number">${quantity}</span> left in stock!`;
      },
      
      get maxQuantity() {
        return this.product.inventoryQuantity || 999;
      },
      
      handleAddToCartClick() {
        // If there are options, open modal
        if (this.hasOptions) {
          // Initialize defaults if not chosen
          if (this.product.options) {
            this.product.options.forEach(o => {
              if (!this.selectedOptions[o.position] && o.values && o.values.length) {
                this.selectedOptions[o.position] = o.values[0];
              }
            });
          }
          this.quantity = 1;
          this.showModal = true;
          this.showQuantitySelector = false;
          return;
        }
        // No options → inline quantity
        this.showQuantitySelector = true;
        this.quantity = 1;
      },
      
      incrementQuantity() {
        if (this.quantity < this.maxQuantity) {
          this.quantity++;
        }
      },
      
      decrementQuantity() {
        if (this.quantity > 1) {
          this.quantity--;
        }
      },
      
      async confirmAddToCart() {
        const variantId = this.selectedVariantId || this.product.variantId;
        if (this.cartLoading || this.buyLoading || !variantId) return;
        if (this.hasOptions && !this.selectedVariantAvailable) {
          alert('Selected variant is unavailable');
          return;
        }
        this.cartLoading = true;
        try {
          await addToCart(variantId, this.quantity);
          this.showModal = false;
          window.location.reload();
        } catch (error) {
          alert(error.message);
          this.cartLoading = false;
        }
      },
      
      async handleBuyNow() {
        const variantId = this.selectedVariantId || this.product.variantId;
        if (this.cartLoading || this.buyLoading || !variantId) return;
        if (this.hasOptions && !this.selectedVariantAvailable) {
          alert('Selected variant is unavailable');
          return;
        }
        this.buyLoading = true;
        try {
          await addToCart(variantId);
          window.location.href = '/checkout';
        } catch (error) {
          alert(error.message);
          this.buyLoading = false;
        }
      },
      
      close() {
        this.closed = true;
        const hurryUpBanner = document.querySelector('.hurry-up-banner');
        if (hurryUpBanner) {
          hurryUpBanner.style.display = 'none';
        }
      }
    };
  }
  
  function renderBanner(product, settings) {
    const price = product.price ? `₹ ${product.price}` : '';
    const showPrice = settings ? settings.showPrice : true;
    
    return `
      <div 
        x-data="createBannerComponent(${JSON.stringify(product).replace(/"/g, '&quot;')})"
        x-init=""
      >
        <!-- Hurry Up Banner - 30px height at top -->
        <div 
          x-show="product.shouldShowLowStock"
          x-cloak
          class="hurry-up-banner"
        >
          <div class="inventory-text" x-html="inventoryMessage">
          </div>
        </div>
        
        <!-- Options + Quantity Modal -->
        <div class="pb-overlay" x-show="showModal" x-cloak @click.self="showModal=false">
          <div class="pb-modal" role="dialog" aria-modal="true">
            <div class="pb-modal-title">Select options</div>
            <template x-if="hasOptions">
              <div>
                <template x-for="opt in product.options" :key="opt.position">
                  <div class="pb-option-group">
                    <label class="pb-option-label" x-text="opt.name"></label>
                    <select class="pb-select" :value="selectedOptions[opt.position]" @change="selectedOptions[opt.position]=$event.target.value">
                      <template x-for="val in opt.values" :key="val">
                        <option :value="val" x-text="val"></option>
                      </template>
                    </select>
                  </div>
                </template>
              </div>
            </template>
            <div class="pb-actions">
              <div class="quantity-selector">
                <button @click="decrementQuantity()" :disabled="quantity<=1" class="quantity-btn">−</button>
                <span class="quantity-display" x-text="quantity"></span>
                <button @click="incrementQuantity()" :disabled="quantity>=maxQuantity" class="quantity-btn">+</button>
              </div>
              <div style="display:flex; gap:8px; align-items:center;">
                <button class="pb-cancel-btn" @click="showModal=false">Cancel</button>
                <button class="confirm-btn" @click="confirmAddToCart()" :disabled="cartLoading || (hasOptions && !selectedVariant)">
                  <span x-show="cartLoading" class="product-banner-spinner"></span>
                  <span x-text="cartLoading ? 'Adding...' : 'Confirm'"></span>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Mobile Banner - Single component -->
        <div class="mobile-banner">
          <div 
            x-show="product.shouldShowLowStock"
            x-cloak
            class="mobile-hurry-up"
          >
            <div class="inventory-text" x-html="inventoryMessage">
            </div>
          </div>
          
          <div class="mobile-product">
            <div class="mobile-product-info">
              <div class="mobile-product-title" x-text="product.title"></div>
              ${showPrice ? `<div class="mobile-product-price" x-text="product.price ? '₹ ' + product.price : ''"></div>` : ''}
            </div>
            
            <!-- Mobile: Show quantity selector or add to cart button -->
            <div class="mobile-product-actions">
              <div x-show="!showQuantitySelector">
                <button 
                  @click="handleAddToCartClick()"
                  class="mobile-add-cart-btn"
                >
                  Add to Cart
                </button>
              </div>
              
              <div x-show="showQuantitySelector" x-cloak class="mobile-quantity-selector">
                <button 
                  @click="decrementQuantity()"
                  :disabled="quantity <= 1"
                  class="mobile-quantity-btn"
                >−</button>
                <span class="mobile-quantity-display" x-text="quantity"></span>
                <button 
                  @click="incrementQuantity()"
                  :disabled="quantity >= maxQuantity"
                  class="mobile-quantity-btn"
                >+</button>
                <button 
                  @click="confirmAddToCart()"
                  :disabled="cartLoading"
                  class="mobile-confirm-btn"
                >
                  <span x-show="cartLoading">Adding...</span>
                  <span x-show="!cartLoading">Confirm</span>
                </button>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Desktop Product Banner -->
        <div id="product-banner-spacer"></div>
        <div class="product-banner-fixed-wrapper">
          <div x-show="!closed" x-cloak>
            <div class="product-banner-container">
              <button 
                class="product-banner-close"
                @click="close()"
                aria-label="Close banner"
              >&times;</button>
              
              <div class="product-banner-content">
                <div class="product-banner-left">
                  <div class="product-banner-image">
                    <img 
                      :src="product.featuredImage || 'https://via.placeholder.com/80'" 
                      :alt="product.title"
                      @error="$el.src='https://via.placeholder.com/80'"
                    />
                  </div>
                  
                  <div class="product-banner-info">
                    <h3 class="product-banner-title" x-text="product.title"></h3>
                    ${showPrice && price ? `<p class="product-banner-price">${price}</p>` : ''}
                  </div>
                </div>
                
                <div class="product-banner-actions">
                  <!-- Show Add to Cart button or Quantity Selector -->
                  <div x-show="!showQuantitySelector">
                    <button
                      @click="handleAddToCartClick()"
                      class="product-banner-btn product-banner-btn-cart"
                    >
                      Add to Cart
                    </button>
                  </div>
                  
                  <div x-show="showQuantitySelector" x-cloak class="quantity-selector">
                    <button 
                      @click="decrementQuantity()"
                      :disabled="quantity <= 1"
                      class="quantity-btn"
                    >−</button>
                    <span class="quantity-display" x-text="quantity"></span>
                    <button 
                      @click="incrementQuantity()"
                      :disabled="quantity >= maxQuantity"
                      class="quantity-btn"
                    >+</button>
                    <button 
                      @click="confirmAddToCart()"
                      :disabled="cartLoading"
                      class="confirm-btn"
                    >
                      <span x-show="cartLoading" class="product-banner-spinner"></span>
                      <span x-text="cartLoading ? 'Adding...' : 'Confirm'"></span>
                    </button>
                  </div>
                  
                  <button
                    @click="handleBuyNow()"
                    :disabled="cartLoading || buyLoading"
                    class="product-banner-btn product-banner-btn-buy"
                  >
                    <span x-show="buyLoading" class="product-banner-spinner"></span>
                    <span x-text="buyLoading ? 'Processing...' : 'Buy Now'"></span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    `;
  }
  
  function applyBannerSettings(settings) {
    const root = document.documentElement;
    
    if (!settings) {
      // Apply default values
      root.style.setProperty('--banner-height', '130px');
      root.style.setProperty('--banner-image-width', '80px');
      root.style.setProperty('--banner-image-height', '80px');
      root.style.setProperty('--banner-title-font-size', '15px');
      root.style.setProperty('--banner-title-color', '#111827');
      root.style.setProperty('--banner-price-font-size', '14px');
      root.style.setProperty('--banner-price-color', '#6b7280');
      root.style.setProperty('--button1-text-color', '#ffffff');
      root.style.setProperty('--button1-bg-color', '#FF6B6B');
      root.style.setProperty('--button1-border-color', '#FF6B6B');
      root.style.setProperty('--button2-text-color', '#FF6B6B');
      root.style.setProperty('--button2-bg-color', '#ffffff');
      root.style.setProperty('--button2-border-color', '#FF6B6B');
      root.style.setProperty('--hurry-up-height', '30px');
      root.style.setProperty('--hurry-up-bg-color', '#FF6B6B');
      root.style.setProperty('--hurry-up-text-color', '#ffffff');
      root.style.setProperty('--hurry-up-font-size', '14px');
      root.style.setProperty('--mobile-banner-height', '90px');
      root.style.setProperty('--mobile-banner-radius', '8px');
      root.style.setProperty('--mobile-banner-margin', '10px');
      root.style.setProperty('--mobile-product-height', '60px');
      root.style.setProperty('--mobile-product-padding', '12px 16px');
      root.style.setProperty('--mobile-title-font-size', '16px');
      root.style.setProperty('--mobile-title-color', '#111827');
      root.style.setProperty('--mobile-price-font-size', '14px');
      root.style.setProperty('--mobile-price-color', '#6b7280');
      root.style.setProperty('--mobile-button-height', '40px');
      root.style.setProperty('--mobile-button-padding', '12px 20px');
      root.style.setProperty('--mobile-button-font-size', '16px');
      root.style.setProperty('--mobile-button-radius', '6px');
      root.style.setProperty('--mobile-button-text-color', '#ffffff');
      root.style.setProperty('--mobile-button-bg-color', '#FF6B6B');
      root.style.setProperty('--mobile-hurry-up-height', '30px');
      root.style.setProperty('--mobile-hurry-up-font-size', '14px');
      root.style.setProperty('--mobile-hurry-up-bg-color', '#FF6B6B');
      root.style.setProperty('--mobile-hurry-up-text-color', '#ffffff');
      return;
    }
    
    // Desktop banner settings
    root.style.setProperty('--banner-height', settings.bannerHeight + 'px');
    root.style.setProperty('--banner-image-width', settings.bannerImageHeight + 'px');
    root.style.setProperty('--banner-image-height', settings.bannerImageHeight + 'px');
    root.style.setProperty('--banner-title-font-size', settings.bannerTitleFontSize + 'px');
    root.style.setProperty('--banner-title-color', '#' + settings.bannerTitleColor);
    root.style.setProperty('--banner-price-font-size', settings.bannerPriceFontSize + 'px');
    root.style.setProperty('--banner-price-color', '#' + settings.bannerPriceColor);
    
    // Button settings
    root.style.setProperty('--button1-text-color', '#' + settings.button1TextColor);
    root.style.setProperty('--button1-bg-color', '#' + settings.button1BackgroundColor);
    root.style.setProperty('--button1-border-color', '#' + settings.button1BorderColor);
    root.style.setProperty('--button2-text-color', '#' + settings.button2TextColor);
    root.style.setProperty('--button2-bg-color', '#' + settings.button2BackgroundColor);
    root.style.setProperty('--button2-border-color', '#' + settings.button2BorderColor);
    
    // Hurry up banner settings
    root.style.setProperty('--hurry-up-height', settings.hurryUpBannerHeight + 'px');
    root.style.setProperty('--hurry-up-bg-color', '#' + settings.hurryUpBannerBackgroundColor);
    root.style.setProperty('--hurry-up-text-color', '#' + settings.hurryUpTextColor);
    root.style.setProperty('--hurry-up-font-size', settings.hurryUpFontSize + 'px');
    
    // Mobile banner settings
    root.style.setProperty('--mobile-banner-height', settings.mobileBannerHeight + 'px');
    root.style.setProperty('--mobile-banner-radius', settings.mobileBannerBorderRadius + 'px');
    root.style.setProperty('--mobile-banner-margin', settings.mobileBannerMargin + 'px');
    root.style.setProperty('--mobile-product-height', settings.mobileProductHeight + 'px');
    root.style.setProperty('--mobile-product-padding', settings.mobileProductPadding);
    
    // Mobile title and price
    root.style.setProperty('--mobile-title-font-size', settings.mobileTitleFontSize + 'px');
    root.style.setProperty('--mobile-title-color', '#' + settings.mobileTitleColor);
    root.style.setProperty('--mobile-price-font-size', settings.mobilePriceFontSize + 'px');
    root.style.setProperty('--mobile-price-color', '#' + settings.mobilePriceColor);
    
    // Mobile button
    root.style.setProperty('--mobile-button-height', settings.mobileButtonHeight + 'px');
    root.style.setProperty('--mobile-button-padding', settings.mobileButtonPadding);
    root.style.setProperty('--mobile-button-font-size', settings.mobileButtonFontSize + 'px');
    root.style.setProperty('--mobile-button-radius', settings.mobileButtonBorderRadius + 'px');
    root.style.setProperty('--mobile-button-text-color', '#' + settings.mobileButtonTextColor);
    root.style.setProperty('--mobile-button-bg-color', '#' + settings.mobileButtonBackgroundColor);
    
    // Mobile hurry up
    root.style.setProperty('--mobile-hurry-up-height', settings.mobileHurryUpHeight + 'px');
    root.style.setProperty('--mobile-hurry-up-font-size', settings.mobileHurryUpFontSize + 'px');
    root.style.setProperty('--mobile-hurry-up-bg-color', '#' + settings.mobileHurryUpBackgroundColor);
    root.style.setProperty('--mobile-hurry-up-text-color', '#' + settings.mobileHurryUpTextColor);
  }
  
  async function init() {
    try {
      const handle = getCurrentProductHandle();
      
      if (!handle) {
        return;
      }
      
      const data = await fetchBannerData(handle);
      const ajax = await fetchProductAjax(handle);
      
      if (!data.product) {
        return;
      }
      
      if (ajax) {
        data.product.options = ajax.options || [];
        data.product.variantsWithOptions = ajax.variantsWithOptions || [];
      }

      applyThemeStyles();
      applyBannerSettings(data.settings);
      
      const container = document.createElement('div');
      container.innerHTML = renderBanner(data.product, data.settings);
      document.body.appendChild(container);
      
    } catch (error) {
      // Silent fail - banner won't show if there's an error
    }
  }
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
  
  window.createBannerComponent = createBannerComponent;
})();
</script>

{% schema %}
{
  "name": "Product Banner",
  "target": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Professional product banner with quantity selector. Automatically appears on product pages."
    }
  ]
}
{% endschema %}