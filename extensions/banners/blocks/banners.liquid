{% comment %}
  Professional Banner System v2.3
  Uses ONLY admin-configured settings (no hardcoded defaults)
  Supports: top-fixed, bottom-fixed, and static positioning
{% endcomment %}

<script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
<script src="https://cdn.tailwindcss.com"></script>

<style>
  /* Reset body margin to prevent offset */
  body {
    margin: 0 !important;
    padding: 0 !important;
  }
  
  /* Banner positioning styles */
  .banner-full-width-wrapper {
    position: static;
    width: 100%;
    z-index: 99999;
  }
  
  /* Fixed positioning - full viewport width */
  .banner-full-width-wrapper.position-top-fixed,
  .banner-full-width-wrapper.position-bottom-fixed {
    position: fixed !important;
    left: 0 !important;
    right: 0 !important;
    width: 100vw !important;
    margin-left: calc(-1 * (100vw - 100%) / 2) !important;
    margin-right: 0 !important;
    padding: 0 !important;
    z-index: 99999 !important;
  }
  
  .banner-full-width-wrapper.position-top-fixed {
    top: 0 !important;
  }
  
  .banner-full-width-wrapper.position-bottom-fixed {
    bottom: 0 !important;
  }
  
  /* Static positioning - parent container width */
  .banner-full-width-wrapper.position-static {
    position: static;
    width: 100%;
    z-index: 99999;
  }
  
  /* Inherit theme typography */
  [x-cloak] { display: none !important; }
  
  .banner-container * {
    font-family: inherit !important;
  }
  
  /* Custom animations */
  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .banner-slide-enter {
    animation: slideIn 0.3s ease-out;
  }
  
  /* Smooth transitions */
  .banner-transition {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  /* Timer styling */
  .timer-segment {
    min-width: 2.5rem;
    text-align: center;
  }
  
  /* Product image styling */
  .product-image-wrapper {
    position: relative;
    overflow: hidden;
  }
  
  .product-image-wrapper img {
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  
  .product-image-wrapper:hover img {
    transform: scale(1.05);
  }
  
  /* Close button - always visible and positioned */
  .close-button {
    position: absolute;
    top: 8px;
    right: 8px;
    transition: all 0.2s ease;
    z-index: 10;
    flex-shrink: 0;
  }
  
  .close-button:hover {
    transform: scale(1.1);
    opacity: 0.8;
  }
  
  /* Banner inner container with padding for close button */
  .banner-inner-container {
    position: relative;
    padding-right: 48px;
  }
  
  /* Ensure full width for fixed positioning */
  .banner-full-width-wrapper.position-top-fixed .banner-inner-container,
  .banner-full-width-wrapper.position-bottom-fixed .banner-inner-container {
    width: 100% !important;
    max-width: none !important;
  }
  
  /* Responsive adjustments */
  @media (max-width: 768px) {
    .banner-content {
      flex-direction: column !important;
      align-items: center !important;
      gap: 1rem !important;
      justify-content: center !important;
    }
    
    .banner-content > div,
    .banner-content > button {
      width: auto !important;
      justify-content: center !important;
    }
    
    .banner-inner-container {
      padding-right: 40px;
    }
    
    .close-button {
      top: 4px;
      right: 4px;
    }
  }
</style>

<div id="banner-root"></div>

<script>
(function() {
  'use strict';
  
  const BANNER_API = '/apps/banners-1/activebanners';
  const ANALYTICS_API = '/apps/banners/analytics';
  const FETCH_TIMEOUT = 5000;
  
  // Utility: Fetch with timeout
  async function fetchWithTimeout(url, options = {}, timeout = FETCH_TIMEOUT) {
    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), timeout);
    
    try {
      const response = await fetch(url, {
        ...options,
        signal: controller.signal,
        headers: {
          'Accept': 'application/json',
          'Content-Type': 'application/json',
          ...options.headers
        }
      });
      clearTimeout(timeoutId);
      return response;
    } catch (error) {
      clearTimeout(timeoutId);
      throw error;
    }
  }
  
  // Utility: Generate session ID
  function generateSessionId() {
    try {
      return btoa(navigator.userAgent + Date.now()).slice(0, 16);
    } catch {
      return 'anonymous-' + Date.now();
    }
  }
  
  // Utility: Get shop domain
  function getShopDomain() {
    return window.Shopify?.shop || window.location.host;
  }
  
  // Analytics tracker
  async function trackEvent(bannerId, eventType, productId = null) {
    try {
      await fetchWithTimeout(ANALYTICS_API, {
        method: 'POST',
        body: JSON.stringify({
          bannerId,
          eventType,
          sessionId: generateSessionId(),
          shopDomain: getShopDomain(),
          productId
        })
      });
    } catch (error) {
      console.warn('Analytics tracking failed:', error);
    }
  }
  
  // Timer calculator
  function calculateTimeRemaining(endTime) {
    const now = new Date();
    const end = new Date(endTime);
    const distance = end - now;
    
    if (distance <= 0) {
      return { expired: true, days: 0, hours: 0, minutes: 0, seconds: 0 };
    }
    
    return {
      expired: false,
      days: Math.floor(distance / (1000 * 60 * 60 * 24)),
      hours: Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)),
      minutes: Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60)),
      seconds: Math.floor((distance % (1000 * 60)) / 1000)
    };
  }
  
  // Format timer display
  function formatTimer(time) {
    const parts = [];
    if (time.days > 0) parts.push(`${time.days}d`);
    if (time.hours > 0) parts.push(`${time.hours}h`);
    if (time.minutes > 0) parts.push(`${time.minutes}m`);
    parts.push(`${time.seconds}s`);
    return parts.join(' ');
  }
  
  // Cart handler
  async function addToCart(variantId, quantity = 1) {
    let numericId = variantId;
    if (typeof variantId === 'string' && variantId.includes('gid://shopify/ProductVariant/')) {
      numericId = variantId.split('/').pop();
    }
    
    const response = await fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        items: [{ id: parseInt(numericId), quantity }]
      })
    });
    
    if (!response.ok) {
      throw new Error('Failed to add to cart');
    }
    
    // Trigger cart update events
    const data = await response.json();
    document.dispatchEvent(new CustomEvent('cart:updated', { detail: data }));
    
    // Update cart count if elements exist
    try {
      const cartResponse = await fetch('/cart.js');
      const cartData = await cartResponse.json();
      
      document.querySelectorAll('[data-cart-count], .cart-count, .cart-counter').forEach(el => {
        el.textContent = cartData.item_count;
      });
    } catch (error) {
      console.warn('Could not update cart display:', error);
    }
    
    return data;
  }
  
  // Banner Alpine component
  function bannerComponent(bannerData) {
    return {
      banner: bannerData,
      currentSlideIndex: 0,
      timers: {},
      closed: false,
      loading: false,
      
      init() {
        trackEvent(this.banner.id, 'view', this.getCurrentProductId());
        
        if (this.banner.hasSlides && this.banner.slides.length > 0) {
          this.banner.slides.forEach((slide, index) => {
            if (slide.isTimer && slide.endTime) {
              this.initTimer(index, slide.endTime);
            }
          });
        } else if (this.banner.isTimer && this.banner.endTime) {
          this.initTimer('main', this.banner.endTime);
        }
        
        if (this.banner.hasSlides && this.banner.slides.length > 1) {
          this.setupCarousel();
        }
      },
      
      destroy() {
        Object.values(this.timers).forEach(timer => {
          if (timer.interval) clearInterval(timer.interval);
        });
      },
      
      initTimer(key, endTime) {
        const updateTimer = () => {
          const time = calculateTimeRemaining(endTime);
          this.timers[key] = { ...time, formatted: formatTimer(time) };
          
          if (time.expired) {
            if (this.timers[key].interval) {
              clearInterval(this.timers[key].interval);
            }
            this.closed = true;
          }
        };
        
        updateTimer();
        this.timers[key] = {
          ...this.timers[key],
          interval: setInterval(updateTimer, 1000)
        };
      },
      
      setupCarousel() {
        setInterval(() => {
          if (!this.closed) {
            this.nextSlide();
          }
        }, 5000);
      },

      nextSlide() {
        this.currentSlideIndex = (this.currentSlideIndex + 1) % this.banner.slides.length;
      },
      
      prevSlide() {
        this.currentSlideIndex = this.currentSlideIndex === 0 
          ? this.banner.slides.length - 1 
          : this.currentSlideIndex - 1;
      },
      
      getCurrentSlide() {
        if (this.banner.hasSlides && this.banner.slides.length > 0) {
          return this.banner.slides[this.currentSlideIndex];
        }
        return this.banner;
      },
      
      getCurrentProductId() {
        const slide = this.getCurrentSlide();
        return slide.productId || this.banner.productId || null;
      },
      
      async handleAddToCart(slide) {
        if (this.loading) return;
        
        const variantId = slide.productVariantId || this.banner.productVariantId;
        if (!variantId) {
          alert('Product variant not available');
          return;
        }

        this.loading = true;
        
        try {
          await addToCart(variantId);
          await trackEvent(this.banner.id, 'add_to_cart', slide.productId || this.banner.productId);
          
          alert('Added to cart!');
          setTimeout(() => window.location.reload(), 500);
        } catch (error) {
          console.error('Add to cart error:', error);
          alert('Failed to add to cart. Please try again.');
        } finally {
          this.loading = false;
        }
      },
      
      handleViewProduct(slide) {
        const handle = slide.productHandle || this.banner.productHandle;
        if (!handle) {
          alert('Product not available');
          return;
        }
        
        trackEvent(this.banner.id, 'view_product', slide.productId || this.banner.productId);
        window.location.href = `/products/${handle}`;
      },
      
      handleClose() {
        trackEvent(this.banner.id, 'close', this.getCurrentProductId());
        this.closed = true;
        this.destroy();
      },
      
      getContainerStyle() {
        const styles = [];
        
        // ONLY use admin settings - no fallbacks
        if (this.banner.bgColor) {
          styles.push(`background-color: ${this.banner.bgColor}`);
        }
        
        if (this.banner.messageColor) {
          styles.push(`color: ${this.banner.messageColor}`);
        }
        
        if (this.banner.bannerBorderRadius !== null && this.banner.bannerBorderRadius !== undefined) {
          styles.push(`border-radius: ${this.banner.bannerBorderRadius}px`);
        }
        
        if (this.banner.bannerPadding !== null && this.banner.bannerPadding !== undefined) {
          styles.push(`padding: ${this.banner.bannerPadding}px`);
        }
        
        // Only apply margins for static positioning
        if (this.banner.position === 'static') {
          if (this.banner.bannerTopMargin !== null && this.banner.bannerTopMargin !== undefined) {
            styles.push(`margin-top: ${this.banner.bannerTopMargin}px`);
          }
          if (this.banner.bannerBottomMargin !== null && this.banner.bannerBottomMargin !== undefined) {
            styles.push(`margin-bottom: ${this.banner.bannerBottomMargin}px`);
          }
          if (this.banner.bannerLeftMargin !== null && this.banner.bannerLeftMargin !== undefined) {
            styles.push(`margin-left: ${this.banner.bannerLeftMargin}px`);
          }
          if (this.banner.bannerRightMargin !== null && this.banner.bannerRightMargin !== undefined) {
            styles.push(`margin-right: ${this.banner.bannerRightMargin}px`);
          }
        }
        
        if (this.banner.customHeight && this.banner.bannerHeight !== 'auto') {
          styles.push(`height: ${this.banner.customHeight}px`);
        }
        
        // Width only for static positioning
        if (this.banner.position === 'static' && this.banner.bannerWidth === 'custom' && this.banner.customWidth) {
          styles.push(`width: ${this.banner.customWidth}%`);
          styles.push(`margin-left: auto`);
          styles.push(`margin-right: auto`);
        }
        
        return styles.join('; ');
      }
    };
  }
  
  // Render banner HTML - USES ONLY ADMIN SETTINGS
  function renderBanner(banner) {
    // Normalize position value (handle both formats)
    let position = banner.position || 'static';
    position = position.replace(/-/g, '_'); // Convert dashes to underscores
    position = position.replace(/_/g, '-'); // Convert back to dashes for CSS class
    
    const positionClass = `position-${position}`;
    
    console.log('Banner position from API:', banner.position);
    console.log('Applied CSS class:', positionClass);
    
    return `
      <div class="banner-full-width-wrapper ${positionClass}">
        <div 
          x-data="bannerComponent(${JSON.stringify(banner).replace(/"/g, '&quot;')})"
          x-show="!closed"
          x-cloak
          class="banner-slide-enter banner-container"
        >
          <div 
            :style="getContainerStyle()"
            class="banner-transition banner-inner-container"
          >
            <div class="banner-content flex items-center justify-evenly w-full">
              
              <!-- Message Section -->
              <div class="flex-shrink-0 min-w-0">
                <template x-if="banner.hasSlides && banner.slides.length > 0">
                  <div>
                    <template x-for="(slide, index) in banner.slides" :key="index">
                      <div x-show="currentSlideIndex === index" class="banner-slide-enter">
                        <p 
                          class="text-base leading-relaxed m-0"
                          :style="'font-size: ' + (slide.messageFontSize || banner.messageFontSize) + 'px; color: ' + (banner.messageColor)"
                          x-text="slide.message"
                        ></p>
                      </div>
                    </template>
                  </div>
                </template>
                
                <template x-if="!banner.hasSlides || banner.slides.length === 0">
                  <div>
                    <template x-if="banner.areMessagesCarousel && banner.messages && banner.messages.length > 1">
                      <div>
                        <template x-for="(message, index) in banner.messages" :key="index">
                          <div x-show="currentSlideIndex === index" class="banner-slide-enter">
                            <p 
                              class="text-base leading-relaxed m-0"
                              :style="'font-size: ' + (banner.messageFontSize) + 'px; color: ' + (banner.messageColor)"
                              x-text="message"
                            ></p>
                          </div>
                        </template>
                      </div>
                    </template>
                    
                    <template x-if="!banner.areMessagesCarousel || !banner.messages || banner.messages.length <= 1">
                      <p 
                        class="text-base leading-relaxed m-0"
                        :style="'font-size: ' + (banner.messageFontSize) + 'px; color: ' + (banner.messageColor)"
                        x-text="banner.messages && banner.messages[0] ? banner.messages[0] : ''"
                      ></p>
                    </template>
                  </div>
                </template>
              </div>
              
              <!-- Timer Display -->
              <template x-if="getCurrentSlide().isTimer && getCurrentSlide().endTime">
                <div 
                  class="timer-display px-4 py-2 rounded-full backdrop-blur-sm flex-shrink-0"
                  :style="'background: ' + (banner.timerBackgroundColor) + '; border: 1px solid ' + (banner.timerBorderColor) + '; color: ' + (banner.timerTextColor) + '; font-size: ' + (banner.timerFontSize) + 'px; padding: ' + (banner.timerPadding) + 'px'"
                >
                  <span x-text="timers[currentSlideIndex]?.formatted || timers.main?.formatted || 'Loading...'"></span>
                </div>
              </template>
              
              <!-- Product Section -->
              <template x-if="getCurrentSlide().hasProduct && (getCurrentSlide().productHandle || getCurrentSlide().productTitle)">
                <div class="flex items-center gap-3 flex-shrink-0">
                  
                  <template x-if="getCurrentSlide().productImage || banner.productImage">
                    <div class="product-image-wrapper w-10 h-10 rounded overflow-hidden border-2 border-white/30">
                      <img 
                        :src="getCurrentSlide().productImage || banner.productImage" 
                        :alt="getCurrentSlide().productTitle || banner.productTitle"
                        class="w-full h-full"
                      />
                    </div>
                  </template>
                  
                  <div class="flex flex-col gap-1">
                    <div 
                      class="font-medium text-sm whitespace-nowrap"
                      :style="'font-size: ' + (banner.productFontSize) + 'px; color: ' + (banner.messageColor)"
                      x-text="getCurrentSlide().productTitle || banner.productTitle"
                    ></div>
                    <template x-if="getCurrentSlide().productPrice || banner.productPrice">
                      <div 
                        class="text-xs opacity-90"
                        :style="'font-size: ' + (banner.productFontSize) + 'px; color: ' + (banner.messageColor)"
                        x-text="(getCurrentSlide().productCurrencyCode || banner.productCurrencyCode) + ' ' + (getCurrentSlide().productPrice || banner.productPrice)"
                      ></div>
                    </template>
                  </div>
                  
                  <template x-if="getCurrentSlide().actionType === 'add_to_cart' && getCurrentSlide().productVariantId">
                    <button
                      @click="handleAddToCart(getCurrentSlide())"
                      :disabled="loading"
                      class="px-4 py-2 rounded font-medium text-sm whitespace-nowrap banner-transition"
                      :style="'background: ' + (getCurrentSlide().actionButtonBackgroundColor || banner.actionButtonBackgroundColor) + '; color: ' + (getCurrentSlide().actionButtonTextColor || banner.actionButtonTextColor) + '; border-radius: ' + (getCurrentSlide().actionButtonBorderRadius || banner.actionButtonBorderRadius) + 'px; padding: ' + (banner.actionButtonPadding) + 'px'"
                    >
                      <span x-show="!loading" x-text="getCurrentSlide().actionButtonText || banner.actionButtonText"></span>
                      <span x-show="loading">Adding...</span>
                    </button>
                  </template>
                  
                  <template x-if="getCurrentSlide().actionType === 'view_product' || !getCurrentSlide().actionType || getCurrentSlide().actionType === ''">
                    <button
                      @click="handleViewProduct(getCurrentSlide())"
                      class="px-4 py-2 rounded font-medium text-sm whitespace-nowrap banner-transition"
                      :style="'background: ' + (getCurrentSlide().actionButtonBackgroundColor || banner.actionButtonBackgroundColor) + '; color: ' + (getCurrentSlide().actionButtonTextColor || banner.actionButtonTextColor) + '; border-radius: ' + (getCurrentSlide().actionButtonBorderRadius || banner.actionButtonBorderRadius) + 'px; padding: ' + (banner.actionButtonPadding) + 'px'"
                    >
                      <span x-text="getCurrentSlide().actionButtonText || banner.actionButtonText"></span>
                    </button>
                  </template>
                </div>
              </template>
              
              <!-- Close Button -->
              <button
                @click="handleClose()"
                class="close-button w-8 h-8 flex items-center justify-center rounded backdrop-blur-sm"
                :style="'background: rgba(255,255,255,0.2); border: 1px solid rgba(255,255,255,0.3); color: ' + (banner.closeIconColor) + '; font-size: ' + (banner.closeIconSize) + 'px; font-weight: bold;'"
                aria-label="Close banner"
              >
                ×
              </button>
            </div>
            
            <!-- Slide Indicators -->
            <template x-if="banner.hasSlides && banner.slides.length > 1">
              <div class="flex justify-center gap-2 mt-3">
                <template x-for="(slide, index) in banner.slides" :key="index">
                  <button
                    @click="currentSlideIndex = index"
                    class="w-2 h-2 rounded-full banner-transition"
                    :class="currentSlideIndex === index ? 'opacity-100' : 'opacity-40'"
                    :style="'background: ' + (banner.messageColor)"
                    :aria-label="'Go to slide ' + (index + 1)"
                  ></button>
                </template>
              </div>
            </template>
          </div>
        </div>
      </div>
    `;
  }
  
  // Main initialization
  async function init() {
    const rootElement = document.getElementById('banner-root');
    if (!rootElement) return;
    
    try {
      const response = await fetchWithTimeout(BANNER_API);
      
      if (!response.ok) {
        throw new Error('Failed to fetch banners');
      }

      const data = await response.json();
      const banners = data.banners || [];
      
      if (banners.length === 0) {
        const defaultMessage = "{{ block.settings.default_message | default: 'Welcome to our store!' }}";
        rootElement.innerHTML = `
          <div class="banner-full-width-wrapper position-static">
            <div style="background: #f7f7f7; color: #1a1a1a; padding: 20px; position: relative; padding-right: 48px; border-radius: 8px;">
              <p class="m-0" style="font-size: 16px;">${defaultMessage}</p>
              <button onclick="this.parentElement.parentElement.remove()" class="close-button w-8 h-8 flex items-center justify-center rounded" style="background: rgba(255,255,255,0.2); position: absolute; top: 8px; right: 8px; color: #1a1a1a; font-size: 16px;">×</button>
            </div>
          </div>
        `;
        return;
      }
      
      banners.sort((a, b) => (a.priority || 0) - (b.priority || 0));
      
      const bannersHTML = banners.map(renderBanner).join('');
      rootElement.innerHTML = bannersHTML;
      
    } catch (error) {
      console.error('Banner initialization error:', error);
      
      const defaultMessage = "{{ block.settings.default_message | default: 'Welcome to our store!' }}";
      rootElement.innerHTML = `
        <div class="banner-full-width-wrapper position-static">
          <div style="background: #f7f7f7; color: #1a1a1a; padding: 20px; position: relative; padding-right: 48px; border-radius: 8px;">
            <p class="m-0" style="font-size: 16px;">${defaultMessage}</p>
            <button onclick="this.parentElement.parentElement.remove()" class="close-button w-8 h-8 flex items-center justify-center rounded" style="background: rgba(255,255,255,0.2); position: absolute; top: 8px; right: 8px; color: #1a1a1a; font-size: 16px;">×</button>
          </div>
        </div>
      `;
    }
  }
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
  
  window.bannerComponent = bannerComponent;
})();
</script>

{% schema %}
{
  "name": "Enhanced Banner System",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "default_message",
      "label": "Default Message",
      "default": "Welcome to our store!",
      "info": "Displayed when no active banners are available"
    }
  ]
}
{% endschema %}